# Прокси в формате http://user:pass@host:port
# Для домашнего сервера оставь пустым — воркер выйдет через твой жилой IP.
# Подключай прокси только если понадобится сменить адрес.
PROXY_URL=

# true = окно браузера видно (для ручного прохода одной капчи), false = headless
HEADED=false

# Персональный токен доступа к стенду (клиент Kilo).
# Сюда его кладёт коллега, чтобы ./install-kilo.sh подхватил без ввода.
# Выдаётся администратором: ./manage-keys.sh gen <имя>
AUTH_TOKEN=

# Соль для рандомизации отпечатка
FINGERPRINT_SALT=changeme-random-string
