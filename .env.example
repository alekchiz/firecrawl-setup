# ====== Firecrawl ======
# ЛИЦЕНЗИЯ: для self-hosted нужен ключ. Добавь вручную из своей учётки.
LICENSE_KEY=
OPENAI_API_KEY=

# ====== Антидетект воркер ======
# Прокси в формате http://user:pass@host:port
# Для домашнего сервера оставь пустым — воркер выйдет через твой жилой IP.
# Подключай прокси только если понадобится сменить адрес.
PROXY_URL=

# true = окно браузера видно (для отладки капчи), false = headless
HEADED=false

# Больше воркеров = больше RAM. На 4GB VPS ставь 1.
NUM_WORKERS_PER_QUEUE=1

# Соль для рандомизации отпечатка
FINGERPRINT_SALT=changeme-random-string
